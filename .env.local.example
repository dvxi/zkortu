# Copy this file to .env.local and fill in values before running locally.
# On Vercel, set these in the project's Environment Variables panel
# (values marked "Sensitive" cannot be pulled with `vercel env pull`).

# API-Tennis (https://api-tennis.com, account → API key). The legacy name
# RAPIDAPI_KEY is still read as a fallback.
API_TENNIS_KEY=your_api_tennis_key

# Resend — https://resend.com/api-keys (domain zkortu.pl must be verified)
RESEND_API_KEY=re_...

# Sanity CMS — https://sanity.io/manage (project g3425kho, dataset production)
NEXT_PUBLIC_SANITY_PROJECT_ID=g3425kho
NEXT_PUBLIC_SANITY_DATASET=production
# Token with Editor rights: needed server-side for comments and seeding.
SANITY_API_TOKEN=sk...

# Optional: secret for the Sanity → Next.js revalidation webhook (/api/revalidate)
SANITY_REVALIDATE_SECRET=change-me

# Optional: canonical site URL used in metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://zkortu.pl
