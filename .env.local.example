# Copy this file to .env.local and fill in values before running locally.
# On Vercel, set these in the project's Environment Variables panel.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...

# API-Tennis via RapidAPI — https://rapidapi.com/sportcontentapi/api/api-tennis
RAPIDAPI_KEY=your_rapidapi_key_here

# Sanity CMS — https://sanity.io/manage (create a project, then copy IDs)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token
